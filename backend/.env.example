# Development-only template. Inject environment variables or use Node --env-file.
# This file is not loaded automatically. Never commit the completed .env file.
# Container environment files must instead use NODE_ENV=production, HTTPS
# PUBLIC_ORIGIN, HOST=0.0.0.0 and MEDIA_ROOT=/app/media.
NODE_ENV=development
DATABASE_URL=postgresql://oaooao:REPLACE_ME@127.0.0.1:5432/oaooao
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
PUBLIC_ORIGIN=http://localhost:3000
# Exact backend target used by the OAOOAO frontend proxy; adjust if it differs.
ALLOWED_ORIGINS=http://127.0.0.1:3001
TRUSTED_PROXY_CIDRS=
HOST=127.0.0.1
PORT=3001
MEDIA_ROOT=./media
# Keep disabled throughout import/reconciliation and candidate inspection.
WORKER_ENABLED=false
# Optional overrides; installed commands on PATH are the defaults.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
